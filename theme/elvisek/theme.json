{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "accent", "name": "Akcent", "color": "var(--ek-accent)" },
				{ "slug": "text", "name": "Text", "color": "var(--ek-text)" },
				{ "slug": "muted", "name": "Tlumený text", "color": "var(--ek-muted)" },
				{ "slug": "surface", "name": "Plocha", "color": "var(--ek-surface)" },
				{ "slug": "background", "name": "Pozadí", "color": "var(--ek-bg)" },
				{ "slug": "chip", "name": "Zvýraznění", "color": "var(--ek-chip)" },
				{ "slug": "line", "name": "Linka", "color": "var(--ek-line)" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"spacing": {
			"units": [ "px", "rem", "%" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "2.5rem" },
				{ "slug": "60", "name": "XL", "size": "4rem" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{ "slug": "small", "name": "Malé", "size": "0.9rem" },
				{ "slug": "medium", "name": "Střední", "size": "1.125rem" },
				{ "slug": "large", "name": "Velké", "size": "1.5rem", "fluid": { "min": "1.3rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Extra velké", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } }
			],
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Nunito Sans",
					"fontFamily": "'Nunito Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
					"fontFace": [
						{ "fontFamily": "Nunito Sans", "fontStyle": "normal", "fontWeight": "200 1000", "fontDisplay": "swap", "src": [ "file:./assets/fonts/nunito-sans-latin-wght-normal.woff2" ], "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD" },
						{ "fontFamily": "Nunito Sans", "fontStyle": "normal", "fontWeight": "200 1000", "fontDisplay": "swap", "src": [ "file:./assets/fonts/nunito-sans-latin-ext-wght-normal.woff2" ], "unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF" },
						{ "fontFamily": "Nunito Sans", "fontStyle": "italic", "fontWeight": "200 1000", "fontDisplay": "swap", "src": [ "file:./assets/fonts/nunito-sans-latin-wght-italic.woff2" ], "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD" },
						{ "fontFamily": "Nunito Sans", "fontStyle": "italic", "fontWeight": "200 1000", "fontDisplay": "swap", "src": [ "file:./assets/fonts/nunito-sans-latin-ext-wght-italic.woff2" ], "unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF" }
					]
				},
				{
					"slug": "heading",
					"name": "Space Grotesk",
					"fontFamily": "'Space Grotesk', system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Space Grotesk", "fontStyle": "normal", "fontWeight": "300 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/space-grotesk-latin-wght-normal.woff2" ], "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD" },
						{ "fontFamily": "Space Grotesk", "fontStyle": "normal", "fontWeight": "300 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/space-grotesk-latin-ext-wght-normal.woff2" ], "unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF" }
					]
				},
				{
					"slug": "mono",
					"name": "JetBrains Mono",
					"fontFamily": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
					"fontFace": [
						{ "fontFamily": "JetBrains Mono", "fontStyle": "normal", "fontWeight": "100 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/jetbrains-mono-latin-wght-normal.woff2" ], "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD" },
						{ "fontFamily": "JetBrains Mono", "fontStyle": "normal", "fontWeight": "100 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/jetbrains-mono-latin-ext-wght-normal.woff2" ], "unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF" }
					]
				}
			]
		}
	},
	"styles": {
		"color": { "background": "var(--ek-bg)", "text": "var(--ek-text)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "lineHeight": "1.7" },
		"elements": {
			"heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "700", "lineHeight": "1.2" } },
			"link": { "color": { "text": "var(--ek-accent)" } }
		},
		"blocks": {
			"core/code": { "typography": { "fontFamily": "var(--wp--preset--font-family--mono)" } },
			"core/preformatted": { "typography": { "fontFamily": "var(--wp--preset--font-family--mono)" } }
		}
	}
}
